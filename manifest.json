{
  "manifest_version": 3,
  "name": "PRONOTE - Assistant Notes & Devoirs IA",
  "version": "2.0.1",
  "description": "Assistant PRONOTE adaptatif selon la page active : simulateur de notes/moyennes et analyse/résumé des devoirs à faire via LM Studio local.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.index-education.net/*",
        "file:///*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
